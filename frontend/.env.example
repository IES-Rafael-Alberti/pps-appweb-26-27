# Base URL of the API used by the browser.
# Relative (default) => same origin / Vite dev proxy.
# Local API:      http://localhost:8080/api/v1
# Production:     https://pps-appweb-26-27-b0q7.onrender.com/api/v1
# The origin without /api/v1 also works: https://pps-appweb-26-27-b0q7.onrender.com
VITE_API_URL=/api/v1

# Only for the Vite dev server proxy (npm run dev).
VITE_PROXY_TARGET=http://localhost:8080
